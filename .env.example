# GrandTour server config. Copy to .env and fill in.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/grandtour
PORT=8787

# Shared secret for the admin API. Generate one: openssl rand -hex 32
ADMIN_TOKEN=
# Comma-separated CORS origins; defaults to the dev admin (http://localhost:5180)
# ALLOWED_ORIGINS=

# AI generation (optional for read-only use)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=        # optional gateway override
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
EXA_API_KEY=
# Reverse geocoding for AI generation location anchoring
GEOCODIO_API_KEY=

# Field diagnostics sink (POST /api/diag/logs). The app no longer posts here —
# its journal stays on the phone (see README) — and the route is unauthenticated
# and writes whatever it is sent to ./diag, so leave it off.
# DIAG_ENABLED=true

# Audio storage for the authoring server (S3/R2-compatible). Omit all to use
# local ./uploads in dev. Not the public bucket — see R2_* below.
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=
# The public bucket content:publish uploads recordings to (plan 016). Its S3
# credentials: an R2 API token with object read & write on this bucket.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=grandtour-data
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Public base of published recordings; bundles name audio as
# <base>/audio/<sha256>.<ext>. Defaults to https://data.grandtour.fyi
# AUDIO_PUBLIC_BASE_URL=
# Cloudflare account token for deploys and bucket administration (wrangler).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# The maintainer's release console at /release (hold or release tracks; what
# GrandTour publishes). Off by default: the generic admin has no such page.
RELEASE_CONSOLE=
