{
  "name": "@grandtour/site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run src/build.ts",
    "dev": "bun run src/build.ts --serve",
    "deploy": "SITE_BUNDLE_BASE_URL=https://data.grandtour.fyi/tours bun run build && bun --env-file=../.env x wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grandtour/shared": "workspace:*",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  }
}
